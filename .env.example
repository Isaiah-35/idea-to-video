# Copy to .env and fill in your keys (or export directly in ~/.zshrc)

# Required — Claude topic extraction, script writing, hooks
ANTHROPIC_API_KEY=sk-ant-...

# Optional — stock video backend (free at pexels.com/api)
PEXELS_API_KEY=...

# Optional — AI video generation via fal.ai (~$0.20/clip)
FAL_KEY=...

# Optional — DALL-E 3 image generation
OPENAI_API_KEY=sk-...
