# Copy this file to .env and fill in your values.
# Real keys live in ~/.secrets — sourced automatically in every terminal.
# This file documents which keys THIS project needs.

ANTHROPIC_API_KEY=           # Required — Claude topic extraction, script writing, hooks
PEXELS_API_KEY=              # Optional — stock video backend (free at pexels.com/api)
FAL_KEY=                     # Optional — AI video generation via fal.ai (~$0.20/clip)
OPENAI_API_KEY=              # Optional — DALL-E 3 image generation
HF_TOKEN=                    # Optional — HuggingFace token for WhisperX pyannote diarization
